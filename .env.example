# Copy to .env and fill in. Never commit the real .env file.

# --- Database (matches docker-compose.yml defaults) ---
DATABASE_URL=postgresql+psycopg://invest:invest@localhost:5432/invest
POSTGRES_USER=invest
POSTGRES_PASSWORD=invest
POSTGRES_DB=invest

# --- SEC EDGAR ---
# Required by data.sec.gov: "AppName contact@email". No API key.
EDGAR_USER_AGENT="invest-research-platform ryanherman57@gmail.com"

# --- Alpha Vantage (free key: https://www.alphavantage.co/support/#api-key) ---
# Second price source. Enables cross-source validation and DELAYED intraday
# quotes. No free source provides real-time consolidated quotes.
ALPHAVANTAGE_API_KEY=

# --- FRED (free API key: https://fred.stlouisfed.org/docs/api/api_key.html) ---
FRED_API_KEY=

# --- EIA (free API key: https://www.eia.gov/opendata/register.php) ---
EIA_API_KEY=

# --- BLS (free, registered key recommended: https://www.bls.gov/developers/) ---
BLS_API_KEY=

# --- BEA (free API key: https://apps.bea.gov/api/signup/) ---
BEA_API_KEY=

# --- App ---
LOG_LEVEL=INFO
