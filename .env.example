# Copy to .env and fill in. NEVER commit .env.
# None of these require a payment method. If a registration flow asks for one,
# stop -- that violates the $0 constraint (CLAUDE.md non-negotiable #1).

# Required. SEC blocks IPs that omit a contact in the User-Agent.
IMT_SEC_CONTACT=your-email@example.com

IMT_DATABASE_URL=postgresql+psycopg://imt:imt@127.0.0.1:5432/imt

# Free registration, instant: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Free registration: https://www.eia.gov/opendata/
EIA_API_KEY=

# Free, raises rate limit from 1,000/day: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# Account + key request; CAN TAKE DAYS. Blocks Phase 6.
SAM_API_KEY=

# FINRA API Platform account
FINRA_API_KEY=

# Local LLM, OpenAI-compatible. Nothing is sent to a hosted provider.
IMT_LLM_BASE_URL=http://localhost:1234/v1
IMT_LLM_MODEL=

IMT_CACHE_DIR=.cache/http
IMT_LOG_LEVEL=INFO
