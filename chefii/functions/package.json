    "ajv": "^8.20.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "openai": "^7.34.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
