//@version=6
// =============================================================================
// AURUM-NY PRIME v2.0
// XAUUSD FTMO NY-Open Quantitative Confluence Research Engine
// -----------------------------------------------------------------------------
// LONG ONLY. One position at a time. No pyramiding. Non-repainting by
// construction: every decision uses only information that existed at the
// decision timestamp.
//
// This script is a RESEARCH ENGINE, not a promise. It implements the setup
// definition deterministically and exports every trade so that the statistics
// Pine cannot compute honestly — bootstrapped expectancy, block-bootstrap Monte
// Carlo, FTMO pass paths, ablation tables, parameter-stability surfaces — are
// computed externally by validation/aurum_validate.py.
//
// What this script deliberately does NOT do:
//   * It does not claim a realtime spread filter. Pine has no bid/ask, so the
//     spread gate here is a MODELLED cost, labelled as such (S27).
//   * It does not claim request.economic() is an economic-event calendar. News
//     blackouts come from user-supplied timestamps, and the dashboard states
//     how many were supplied (S42).
//   * It does not compute bootstrap confidence intervals. Those are external.
//     The Wilson interval IS computed here because it is a closed form and
//     nothing is lost by evaluating it in Pine (S63).
//
// Section numbers in comments (S1..S90) map to docs/01_mathematical_spec.md.
// =============================================================================

strategy(
     title                   = "AURUM-NY PRIME v2.0",
     shorttitle              = "AURUM-NY",
     overlay                 = true,
     initial_capital         = 100000,
     currency                = currency.USD,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 1,
     pyramiding              = 0,
     calc_on_every_tick      = false,
     calc_on_order_fills     = false,
     process_orders_on_close = false,
     close_entries_rule      = "ANY",
     commission_type         = strategy.commission.cash_per_contract,
     commission_value        = 0.0,
     slippage                = 0,
     max_labels_count        = 500,
     max_lines_count         = 500,
     max_boxes_count         = 100,
     max_bars_back           = 1000)

// Commission and slippage are declaration-time constants in Pine and therefore
// CANNOT be wired to inputs. Set them in Strategy Properties before drawing any
// conclusion from a backtest: docs/05_execution_audit.md gives the numbers to
// use. The internal cost model below feeds position sizing and stop buffers; it
// does not replace tester costs, and it is not a substitute for them.

// =============================================================================
// 0. CONSTANTS
// =============================================================================
string TZ = "America/New_York"

string G_MODE  = "1 · Mode"
string G_SYM   = "2 · Confirmation markets"
string G_TIME  = "3 · Sessions (America/New_York)"
string G_HTF   = "4 · Higher-timeframe gold regime"
string G_ORB   = "5 · NY opening range"
string G_VWAP  = "6 · Anchored VWAP"
string G_PIV   = "7 · Pivots · trendline · third touch"
string G_REJ   = "8 · Rejection candle · microstructure"
string G_INTER = "9 · Intermarket"
string G_EXEC  = "10 · Volatility · execution quality"
string G_RISK  = "11 · Risk · FTMO"
string G_EXIT  = "12 · Targets · exits"
string G_SCORE = "13 · Confluence score"
string G_NEWS  = "14 · News blackout"
string G_ABL   = "15 · Ablation switches"
string G_UI    = "16 · Dashboard · logging"

// State-machine labels (S57)
string ST_IDLE    = "IDLE"
string ST_HTF     = "HTF_BULL"
string ST_ASIA    = "ASIA_COMPLETE"
string ST_LONDON  = "LONDON_CONFIRMED"
string ST_OR      = "NY_OR_DEFINED"
string ST_BREAK   = "ORB_BREAK"
string ST_ACCEPT  = "ORB_ACCEPTED"
string ST_PIVOTS  = "PIVOTS_VALID"
string ST_TL      = "TRENDLINE_VALID"
string ST_WAIT3   = "WAIT_TOUCH_3"
string ST_TOUCH3  = "TOUCH_3"
string ST_REJECT  = "REJECTION"
string ST_MACRO   = "MACRO_CONFIRM"
string ST_ARMED   = "ARMED"
string ST_ENTRY   = "ENTRY"
string ST_OPEN    = "POSITION_OPEN"
string ST_BE      = "BREAKEVEN_ELIGIBLE"
string ST_TP1     = "TP1"
string ST_TP2     = "TP2"
string ST_RUNNER  = "RUNNER"
string ST_CLOSED  = "CLOSED"
string ST_INVALID = "INVALIDATED"

// =============================================================================
// 1. INPUTS
// =============================================================================

// ---- 1.1 Mode (S5, S23, S35, S46) -------------------------------------------
i_evalMode   = input.string("FTMO 2-Step", "Evaluation mode", options = ["FTMO 2-Step", "FTMO 1-Step", "Research Only"], group = G_MODE)
i_phase      = input.string("Phase 1", "Evaluation phase (2-step)", options = ["Phase 1", "Verification"], group = G_MODE)
i_entryMode  = input.string("Conservative", "Entry mode (S35)", options = ["Conservative", "Moderate"], group = G_MODE, tooltip = "Conservative: max(H3, micro pivot high) + 1 tick. Moderate: H3 + 1 tick. Compare both out-of-sample.")
i_stopModel  = input.string("A · Touch #3", "Stop model (S46)", options = ["A · Touch #3", "B · Pivot #2"], group = G_MODE, tooltip = "Test A and B independently. Do NOT let an optimiser pick whichever wins on final out-of-sample data.")
i_volMode    = input.string("Broker volume", "XAU volume mode (S23)", options = ["Broker volume", "Tick volume", "GC confirmation", "Price-only VWAP", "Disable volume-strength filter"], group = G_MODE, tooltip = "XAUUSD volume is not centralised transaction volume. The mode used is recorded in every exported trade row.")

// ---- 1.2 Confirmation markets (S4) ------------------------------------------
i_symGC      = input.symbol("COMEX:GC1!",  "COMEX gold futures",      group = G_SYM)
i_symDXY     = input.symbol("TVC:DXY",     "US dollar index",         group = G_SYM)
i_symVIX     = input.symbol("CBOE:VIX",    "VIX",                     group = G_SYM)
i_symRY      = input.symbol("FRED:DFII10", "10y real-yield proxy",    group = G_SYM, tooltip = "FRED:DFII10 is the 10-year TIPS yield. Point it at any reliable real-yield series your feed carries.")
i_symUST     = input.symbol("TVC:US10Y",   "10y nominal-yield proxy", group = G_SYM)
i_useRY      = input.bool(true,  "Use real-yield proxy",    group = G_SYM)
i_useUST     = input.bool(false, "Use nominal-yield proxy", group = G_SYM, tooltip = "Off by default: nominal and real yields are highly correlated, and double-counting them is untested (S39).")

// ---- 1.3 Sessions (S9, S10, S11, S14, S17) ----------------------------------
i_asiaStart  = input.string("20:00", "Asia session start (ET)",     group = G_TIME)
i_asiaEnd    = input.string("02:00", "Asia session end (ET)",       group = G_TIME)
i_lonStart   = input.string("02:00", "London session start (ET)",   group = G_TIME)
i_lonEnd     = input.string("08:20", "London session end (ET)",     group = G_TIME)
i_orStart    = input.string("08:20", "NY opening range start (ET)", group = G_TIME)
i_orEnd      = input.string("08:35", "NY opening range end (ET)",   group = G_TIME)
i_tradeStart = input.string("08:35", "First entry allowed (ET)",    group = G_TIME)
i_tradeEnd   = input.string("11:30", "Last entry allowed (ET)",     group = G_TIME)
i_flatTime   = input.string("12:00", "Flatten all positions (ET)",  group = G_TIME)
i_runnerLate = input.bool(false, "Runner mode: allow runner past flatten time", group = G_TIME, tooltip = "Research switch (S9). Off = hard flat at the flatten time.")
i_runnerEnd  = input.string("16:00", "Runner hard flatten (ET)",    group = G_TIME)
i_maxSweep   = input.float(0.50, "Maximum Asia-low sweep depth (× ATR15)", minval = 0.05, step = 0.05, group = G_TIME)
i_sweepBars  = input.int(3, "Reclaim must complete within N bars", minval = 1, maxval = 12, group = G_TIME)
i_dayReset   = input.string("00:00", "Daily risk accounting resets (ET)", group = G_TIME, tooltip = "FTMO resets the daily loss limit on its own server clock. Set this to that time expressed in ET.")

// ---- 1.4 HTF regime (S16) ----------------------------------------------------
i_tf4h       = input.timeframe("240", "HTF regime timeframe A", group = G_HTF)
