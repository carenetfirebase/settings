i_ablPreset = input.string("J · Full AURUM-NY PRIME", "Ablation preset", options = ["A · ORB only", "B · + VWAP", "C · + Asia/London", "D · + pivots", "E · + third touch", "F · + DXY", "G · + GC", "H · + rates", "I · + VIX", "J · Full AURUM-NY PRIME", "Custom"], group = G_ABL)
i_cHTF      = input.bool(true, "Custom · HTF regime",  group = G_ABL)
